{
  "name": "codemirror-blocks-workspace",
  "description": "Workspace for codemirror-blocks related packaged",
  "private": "true",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "workspaces": [
    "packages/cmb-toolkit",
    "packages/codemirror-blocks",
    "packages/example",
    "packages/lambda",
    "packages/routine",
    "packages/wescheme",
    "packages/wescheme-blocks"
  ],
  "scripts": {
    "test": "jest",
    "test-watch": "jest --watch",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format:check": "prettier --check .",
    "soak": "node scripts/soak.js",
    "test:e2e": "npm run test:e2e --workspace=@bootstrapworld/codemirror-blocks",
    "build:libs": "npm run build --workspace=@bootstrapworld/codemirror-blocks && npm run build --workspace=@bootstrapworld/example && npm run build --workspace=@bootstrapworld/lambda && npm run build --workspace=@bootstrapworld/routine && npm run build --workspace=@bootstrapworld/wescheme",
    "build:types": "npm run build-types --workspaces --if-present",
    "build:all": "npm run build:libs && npm run build:types",
    "demo": "node scripts/demo.js",
    "bundle": "npm run bundle --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
