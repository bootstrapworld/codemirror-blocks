{
  "name": "codemirror-blocks-workspace",
  "description": "Workspace for codemirror-blocks related packaged",
  "private": "true",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "workspaces": [
    "packages/cmb-toolkit",
    "packages/codemirror-blocks",
    "packages/wescheme-blocks"
  ],
  "scripts": {
    "test": "jest",
    "test-watch": "jest --watch",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspace=codemirror-blocks",
    "format:check": "prettier --check .",
    "test:e2e": "npm run test:e2e --workspace=codemirror-blocks"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
