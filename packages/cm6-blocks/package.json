{
  "name": "@bootstrapworld/cm6-blocks",
  "version": "0.0.0",
  "private": true,
  "description": "EXPERIMENT: blocks on CodeMirror 6, without React, by direct edits of one tree (see doc/experiments/cm6-direct-tree.md)",
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc -p . --noEmit",
    "build": "esbuild demo/demo.ts --bundle --format=iife --sourcemap --loader:.css=text --outfile=demo/demo.js",
    "build:min": "esbuild demo/demo.ts --bundle --format=iife --minify --loader:.css=text --outfile=demo/demo.js",
    "serve": "esbuild demo/demo.ts --bundle --format=iife --sourcemap --loader:.css=text --outfile=demo/demo.js --servedir=demo --serve=8177",
    "build:min:scheme": "esbuild demo/scheme-only.ts --bundle --format=iife --minify --loader:.css=text --outfile=demo/scheme-only.js",
    "build:css": "node scripts/build-css.cjs && prettier --write src/css",
    "build:min:javascript": "esbuild demo/javascript-only.ts --bundle --format=iife --minify --outfile=demo/javascript-only.js",
    "build:min:python": "esbuild demo/python-only.ts --bundle --format=iife --minify --outfile=demo/python-only.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.5",
    "@lezer/generator": "^1.8.1",
    "@lezer/javascript": "^1.5.6",
    "@lezer/lr": "^1.4.12",
    "@lezer/python": "^1.1.19",
    "cm6-lezer-scheme-common-lang": "^0.1.2"
  }
}
