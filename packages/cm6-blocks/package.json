{
  "name": "@bootstrapworld/cm6-blocks",
  "version": "0.0.0",
  "private": true,
  "description": "EXPERIMENT: blocks on CodeMirror 6, without React, by direct edits of one tree (see doc/experiments/cm6-direct-tree.md)",
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc -p . --noEmit",
    "soak": "node scripts/soak.js",
    "leak:check": "esbuild scripts/leak-check.ts --bundle --platform=node --format=cjs --loader:.css=text --external:jsdom --external:typescript --log-level=warning --outfile=scripts/leak-check.build.cjs && node --expose-gc scripts/leak-check.build.cjs",
    "fuzz:parse": "esbuild scripts/parse-fuzz.ts --bundle --platform=node --format=cjs --loader:.css=text --external:jsdom --external:typescript --log-level=warning --outfile=scripts/parse-fuzz.build.cjs && node scripts/parse-fuzz.build.cjs",
    "build": "npm run build:min && npm run build:min:scheme && npm run build:min:javascript && npm run build:min:python",
    "build:min": "esbuild demo/demo.ts --bundle --format=iife --minify --loader:.css=text --outfile=demo/demo.js",
    "serve": "esbuild demo/demo.ts --bundle --format=iife --sourcemap --loader:.css=text --outfile=demo/demo.js --servedir=demo --serve=8177",
    "build:min:scheme": "esbuild demo/scheme-only.ts --bundle --format=iife --minify --loader:.css=text --outfile=demo/scheme-only.js",
    "build:min:javascript": "esbuild demo/javascript-only.ts --bundle --format=iife --minify --loader:.css=text --outfile=demo/javascript-only.js",
    "build:min:python": "esbuild demo/python-only.ts --bundle --format=iife --minify --loader:.css=text --outfile=demo/python-only.js",
    "build:dev": "esbuild demo/demo.ts --bundle --format=iife --sourcemap --loader:.css=text --outfile=demo/demo.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.5",
    "@lezer/generator": "^1.8.1",
    "@lezer/javascript": "^1.5.6",
    "@lezer/lr": "^1.4.12",
    "@lezer/python": "^1.1.19",
    "cm6-lezer-scheme-common-lang": "^0.1.2"
  }
}
