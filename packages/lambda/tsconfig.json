{
  "include": ["src/**/*"],
  "compilerOptions": {
    "esModuleInterop": true,
    "target": "es2019",
    "jsx": "react",
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": "./src",
    "types": ["node"],
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "isolatedModules": true,
    "outDir": "lib",
    "strict": true
  }
}
