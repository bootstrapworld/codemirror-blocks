{
  "include": ["src/**/*"],
  "compilerOptions": {
    "esModuleInterop": true,
    "target": "es6",
    // (this used to come in via the automatically included @types/node)
    "lib": ["es2019", "dom"],
    "jsx": "react",
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": "./src",
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    // Don't typecheck stuff internal to node_modules
    "skipLibCheck": true,
    // Ensure that .d.ts files are created by tsc, but not .js files
    "declaration": true,
    "emitDeclarationOnly": true,
    // Ensure that Babel can safely transpile files in the TypeScript project
    "isolatedModules": true,
    "outDir": "lib",
    // TypeScript 6 turns "strict" on by default; this package opts into the
    // checks below one at a time.
    "strict": false,
    // TODO(pcardune) turn noImplicitAny on when we're ready for it
    // "noImplicitAny": true,
    "noImplicitThis": true,
    "strictPropertyInitialization": true,
    "strictNullChecks": true,
    "allowJs": true
  }
}
