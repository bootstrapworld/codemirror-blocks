{
  "include": ["src/**/*"],
  "compilerOptions": {
    "esModuleInterop": true,
    "target": "es6",
    "module": "node16",
    "jsx": "react",
    "moduleResolution": "node16",
    "rootDir": "./src",
    "sourceMap": true,
    "declaration": true,
    "outDir": "lib",
    "strict": true,
    // Don't typecheck stuff internal to node_modules
    "skipLibCheck": true,
  }
}
