{
  "name": "@bootstrapworld/codemirror-blocks",
  "version": "0.9.0",
  "description": "CodeMirror extension for using draggable blocks to write programming languages",
  "main": "./lib/CodeMirrorBlocks.js",
  "types": "./lib/CodeMirrorBlocks.d.ts",
  "exports": {
    ".": {
      "types": "./lib/CodeMirrorBlocks.d.ts",
      "default": "./lib/CodeMirrorBlocks.js"
    },
    "./css/*.css": "./lib/css/*.css",
    "./less/*.less": "./lib/less/*.less",
    "./testing": {
      "types": "./lib/toolkit/test-utils.d.ts",
      "default": "./lib/toolkit/test-utils.js"
    },
    "./conformance": {
      "types": "./lib/toolkit/comment-conformance.d.ts",
      "default": "./lib/toolkit/comment-conformance.js"
    },
    "./debug": {
      "types": "./lib/toolkit/debug.d.ts",
      "default": "./lib/toolkit/debug.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "/lib",
    "/dist/*-min.js",
    "/dist/*-min.js.map",
    "/dist/*-min.js.LICENSE.txt",
    "/dist/*.css",
    "/dist/lite/*-min.js",
    "/dist/lite/*-min.js.map",
    "/dist/lite/*-min.js.LICENSE.txt"
  ],
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "dependencies": {
    "classnames": "^2.3.1",
    "codemirror": "^5.65.7",
    "fast-json-stable-stringify": "^2.1.0",
    "pretty-fast-pretty-printer": "^0.10.0",
    "react": "^19.2.0",
    "react-codemirror2": "^9.0.1",
    "react-contenteditable": "^3.3.6",
    "react-dom": "^19.2.0",
    "react-modal": "^3.15.1",
    "react-redux": "^9.2.0",
    "react-tabs": "^6.1.1",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "reselect": "^5.1.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.20.7",
    "@babel/core": "^7.20.12",
    "@babel/plugin-proposal-class-properties": "^7.17.12",
    "@babel/plugin-transform-modules-commonjs": "^7.18.2",
    "@babel/preset-env": "^7.18.9",
    "@babel/preset-react": "^7.18.6",
    "@babel/preset-typescript": "^7.18.6",
    "@bootstrapworld/cmb-toolkit": "*",
    "@bootstrapworld/example": "*",
    "@bootstrapworld/lambda": "*",
    "@bootstrapworld/routine": "*",
    "@bootstrapworld/wescheme": "*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/codemirror": "^5.60.5",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-modal": "^3.13.1",
    "@types/webpack-bundle-analyzer": "^4.4.1",
    "babel-jest": "^30.5.2",
    "babel-loader": "^10.1.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "less": "^4.9.1",
    "preact": "^11.2.0",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.1",
    "typescript": "^6.0.3",
    "webpack-bundle-analyzer": "^5.4.2",
    "webpack-cli": "^7.3.1"
  },
  "peerDependencies": {
    "codemirror": "^5.65.7"
  },
  "scripts": {
    "prepare": "npm run build && npm run build-types",
    "build-sounds": "node scripts/inline-sounds.js",
    "start": "webpack serve --config webpack/example.config.js",
    "build": "npx babel src --out-dir lib --source-maps inline --copy-files --extensions \".ts,.tsx,.js,.jsx\" && npm run build-css",
    "build-css": "node scripts/build-css.js",
    "build-watch": "npm run build -- --watch",
    "build-types": "npx tsc",
    "typecheck": "tsc -p . --emitDeclarationOnly false --noEmit && tsc -p spec --noEmit && tsc -p e2e --noEmit",
    "analyze": "webpack --config webpack/example.config.js --mode=production --json=dist/stats.json && webpack-bundle-analyzer dist/stats.json",
    "build-types-watch": "npx tsc --watch",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "bundle": "npm run bundle:full && npm run bundle:lite",
    "bundle:full": "webpack --config webpack/umd.config.js && cp lib/css/codemirror-blocks.css dist/codemirror-blocks.css",
    "bundle:lite": "webpack --config webpack/umd-lite.config.js"
  },
  "author": "The Bootstrap Team",
  "repository": "github:bootstrapworld/codemirror-blocks",
  "contributors": [
    "Paul Carduner",
    "Zachary Espiritu",
    "Aleksey Kliger",
    "Justin Pombrio",
    "Sorawee Porncharoenwase",
    "Emmanuel Schanzer",
    "Dorai Sitaram",
    "Preston Tunnell Wilson"
  ],
  "license": "MIT",
  "unpkg": "dist/codemirror-blocks-min.js",
  "jsdelivr": "dist/codemirror-blocks-min.js"
}
