{
  "name": "codemirror-blocks",
  "version": "0.8.6",
  "description": "CodeMirror extension for using draggable blocks to write programming languages",
  "main": "./lib/CodeMirrorBlocks.js",
  "files": [
    "/lib"
  ],
  "engines": {
    "node": ">=18.x",
    "npm": ">=8.x"
  },
  "dependencies": {
    "classnames": "^2.3.1",
    "codemirror": "^5.65.7",
    "fast-json-stable-stringify": "^2.1.0",
    "pretty-fast-pretty-printer": "^0.10.0",
    "react": "^18.3.1",
    "react-codemirror2": "^8.0.1",
    "react-contenteditable": "^3.3.6",
    "react-dnd": "^14.0.5",
    "react-dnd-html5-backend": "^14.1.0",
    "react-dom": "^18.3.1",
    "react-modal": "^3.15.1",
    "react-redux": "^8.1.3",
    "react-tabs": "^6.1.1",
    "redux": "^4.2.0",
    "reselect": "^4.1.6",
    "redux-thunk": "^2.4.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.18.9",
    "@babel/core": "^7.18.2",
    "@babel/plugin-proposal-class-properties": "^7.17.12",
    "@babel/plugin-transform-modules-commonjs": "^7.18.2",
    "@babel/preset-env": "^7.18.9",
    "@babel/preset-react": "^7.16.7",
    "@babel/preset-typescript": "^7.18.6",
    "@bootstrapworld/cmb-toolkit": "*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/codemirror": "^5.60.5",
    "@types/html-webpack-plugin": "^3.2.6",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-modal": "^3.13.1",
    "@types/webpack": "^5.28.0",
    "@types/webpack-bundle-analyzer": "^4.4.1",
    "@types/webpack-dev-server": "^4.7.2",
    "babel-jest": "^29.7.0",
    "babel-loader": "^8.2.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3",
    "webpack-cli": "^4.10.0"
  },
  "peerDependencies": {
    "codemirror": "^5.65.7"
  },
  "optionalDependencies": {
    "wescheme-js": "^0.0.4"
  },
  "scripts": {
    "prepare": "npm run build && npm run build-types",
    "start": "webpack serve --config webpack/example.config.js",
    "build": "npx babel src --out-dir lib --source-maps inline --copy-files --extensions \".ts,.tsx,.js,.jsx\"",
    "build-watch": "npm run build -- --watch",
    "build-types": "npx tsc",
    "typecheck": "tsc -p . --emitDeclarationOnly false --noEmit",
    "build-types-watch": "npx tsc --watch",
    "lint": "eslint .",
    "upgrade-interactive": "npm-check --update"
  },
  "author": "The Bootstrap Team",
  "repository": "github:bootstrapworld/codemirror-blocks",
  "contributors": [
    "Paul Carduner",
    "Zachary Espiritu",
    "Aleksey Kliger",
    "Justin Pombrio",
    "Sorawee Porncharoenwase",
    "Emmanuel Schanzer",
    "Dorai Sitaram",
    "Preston Tunnell Wilson"
  ],
  "license": "MIT"
}
